# Connect Me Web — local environment template
# Copy to apps/web/.env for workspace-local Next.js development.
# In Vercel, set API_INTERNAL_URL in the web project's Environment Variables.

NODE_ENV=development

# Server-only Express API origin. Never prefix this with NEXT_PUBLIC_.
# Local API default: http://localhost:4000
# Vercel deployment: https://<your-api-project>.vercel.app
API_INTERNAL_URL=http://localhost:4000

# The web app calls its same-origin /api/* proxy; no database credentials,
# signing secrets, CORS_ORIGIN, or QR_CANONICAL_ORIGIN belong in this file.
