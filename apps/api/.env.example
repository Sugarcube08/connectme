# Connect Me API — local environment template
# Copy to apps/api/.env for workspace-local API development. Database tooling also loads this file.
# Production deployments should set these through the hosting platform.
#
# Prisma MySQL URL format:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
# Example shape (replace every component with your real values):
# mysql://connectme_user:URL_ENCODED_PASSWORD@127.0.0.1:3306/connectme
#
# Prisma requires special/reserved characters in URL components to be percent-encoded.
# Example password: p@ss:word% -> p%40ss%3Aword%25
# Keep the original encoded URL in DATABASE_URL; do not decode it manually.

NODE_ENV=development
PORT=4000

# Required MySQL URLs. Test database name must end in _test or _testing.
DATABASE_URL=
TEST_DATABASE_URL=

# Required independent signing keys; generate each with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=

# Optional operational limits
MAX_IMAGE_SIZE_BYTES=2097152
MAX_BATCH_CODE_COUNT=100
