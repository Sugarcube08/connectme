# Connect Me API — local environment template
# Production deployments should set these through the hosting platform.

# MySQL URI format: mysql://USER:PASSWORD@HOST:3306/DATABASE
# Percent-encode reserved characters in URL components, e.g. p@ss:word% -> p%40ss%3Aword%25.
NODE_ENV=development
PORT=4000
DATABASE_URL=
TEST_DATABASE_URL=

# Generate independent 32-byte secrets with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=
ACCESS_CODE_PEPPER=

MAX_IMAGE_SIZE_BYTES=2097152
MAX_BATCH_CODE_COUNT=100

# Email & OTP Verification via Gmail SMTP
# Set OTP_VERIFICATION=true to activate the 6-digit email OTP verification pipeline during registration.
# If false, independent registration completes immediately without requiring email OTP.
OTP_VERIFICATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# For Gmail, generate an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
