{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "SESSION_SECRET",
    "JWT_SECRET",
    "API_INTERNAL_URL",
    "NEXT_PUBLIC_APP_URL"
  ],
  "globalEnv": [
    "NODE_ENV",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@connectme/database#build": {
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
