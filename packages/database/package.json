{
  "name": "@connectme/database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "tsx scripts/prisma-cli.ts generate",
    "migrate": "tsx scripts/prisma-cli.ts migrate deploy",
    "migrate:dev": "tsx scripts/prisma-cli.ts migrate dev",
    "build": "tsx scripts/prisma-cli.ts generate && tsc",
    "bootstrap": "tsx src/bootstrap.ts",
    "migrate:status": "tsx scripts/prisma-cli.ts migrate status",
    "bootstrap:rotate": "tsx src/bootstrap.ts --rotate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.13.4"
  }
}
