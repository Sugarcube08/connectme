# Connect Me environment template
# Copy this file to .env and replace every blank value before starting services.
# Generate secrets with: openssl rand -hex 32
# Use a URL-safe database password (hex output) when constructing DATABASE_URL.

NODE_ENV=development

# PostgreSQL (used by docker compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=connectme

# PostgreSQL connection used by Prisma in API and database tooling.
# Example shape only; replace username/password/database with your own values.
DATABASE_URL=
# Isolated database for integration tests (database name should end in _test).
TEST_DATABASE_URL=

# Required signing keys; never commit real values.
SESSION_SECRET=
JWT_SECRET=

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
QR_CANONICAL_ORIGIN=http://localhost:3000
MAX_IMAGE_SIZE_BYTES=2097152
MAX_BATCH_CODE_COUNT=100

# Web (server-only proxy target; never use NEXT_PUBLIC_ for this variable)
API_INTERNAL_URL=http://localhost:4000

# Optional Docker Compose override when running only the web profile against an externally hosted API.
# Leave blank for the combined profile, where the internal service name http://api:4000 is used.
COMPOSE_API_INTERNAL_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave blank to use the same-origin Next.js proxy (/api/v1).
# Set to the public API origin only when web and API are deployed on separate origins.
NEXT_PUBLIC_API_BASE_URL=

# Mobile client; use a reachable API origin for the device/emulator.
EXPO_PUBLIC_API_URL=http://localhost:4000
