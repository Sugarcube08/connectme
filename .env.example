# Connect Me environment template
# Copy this file to .env for Docker Compose and monorepo-level tooling.
# For standalone app development, see apps/api/.env.example and apps/web/.env.example.
# Generate independent secrets with: openssl rand -hex 32
# Use URL-safe passwords for Compose; percent-encode reserved characters in external MySQL URLs.

NODE_ENV=development

# MySQL for local Docker Compose
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=connectme

# MySQL URLs for API/tooling and isolated integration tests
DATABASE_URL=
TEST_DATABASE_URL=

# Required independent secrets; do not reuse these values
SESSION_SECRET=
JWT_SECRET=
ACCESS_CODE_PEPPER=

# API
PORT=4000
MAX_IMAGE_SIZE_BYTES=2097152
MAX_BATCH_CODE_COUNT=100

# Email & OTP Verification via Gmail SMTP
# Set OTP_VERIFICATION=true to activate the 6-digit email OTP verification pipeline during registration.
# If false, independent registration completes immediately without requiring email OTP.
OTP_VERIFICATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server-only web proxy target
API_INTERNAL_URL=http://localhost:4000
COMPOSE_API_INTERNAL_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mobile origins
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_URL=http://localhost:3000
