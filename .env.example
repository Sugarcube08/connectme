# Connect Me Environment Configuration

# Application & Network
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
QR_CANONICAL_ORIGIN=http://localhost:3001

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/connectme

# Admin Credentials (Initial setup/seed)
ADMIN_EMAIL=admin@connectme.local
ADMIN_INITIAL_PASSWORD=DevconRoyal2026!Secure

# Cryptographic & Session Secrets (Change in production)
SESSION_SECRET=devcon-obsidian-royal-secret-key-must-be-32-chars-long-min
JWT_SECRET=devcon-jwt-secret-key-for-mobile-admin-auth-tokens-32-chars

# Security & Limits
MAX_UPLOAD_IMAGE_SIZE_BYTES=2097152
MAX_BATCH_CODE_COUNT=100
