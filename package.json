{
  "name": "connect-me",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "postinstall": "pnpm --filter @connectme/database generate",
    "dev:api": "pnpm --filter @connectme/api dev",
    "dev:web": "pnpm --filter @connectme/web dev",
    "dev:mobile": "pnpm --filter @connectme/mobile start",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @connectme/database generate",
    "db:migrate": "pnpm --filter @connectme/database migrate",
    "db:bootstrap": "pnpm --filter @connectme/database bootstrap",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "dev:api:web": "turbo run dev --filter=@connectme/api --filter=@connectme/web --parallel",
    "db:migrate:dev": "pnpm --filter @connectme/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @connectme/database migrate",
    "db:migrate:status": "pnpm --filter @connectme/database migrate:status",
    "db:bootstrap:rotate": "pnpm --filter @connectme/database bootstrap:rotate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.11.2"
}
